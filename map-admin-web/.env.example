# Las variables VITE_ quedan visibles en el navegador. Solo valores públicos.
VITE_API_URL=http://localhost:3000/api/v1

# oidc = SSO corporativo (producción). dev = pegar el ADMIN_DEV_TOKEN de map-api (solo desarrollo).
VITE_ADMIN_AUTH_MODE=dev

# Solo con oidc. Entra ID: https://login.microsoftonline.com/<tenant>/v2.0  Keycloak: https://sso.tuorg.com/realms/<realm>
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
# Debe pedir el scope de la API para que el token tenga el audience correcto (ej. Entra: api://<id>/access_as_admin)
VITE_OIDC_SCOPE=openid profile email

# Para los ejemplos de integración que muestra el panel
VITE_EMBED_URL=http://localhost:5173/embed
