# Las variables VITE_ quedan visibles en el navegador. Solo valores públicos.
VITE_API_URL=http://localhost:3000/api/v1
# Llave de ArcGIS SOLO con privilegio de mapa base y restringida por referrer al dominio del iframe.
VITE_ARCGIS_BASEMAP_KEY=
# Opcionales
VITE_ARCGIS_BASEMAP=arcgis/streets
# Centro inicial: longitud,latitud
VITE_MAP_CENTER=-74.0721,4.711
VITE_MAP_ZOOM=12
