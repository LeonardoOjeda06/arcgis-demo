# Ambiente: development, test o production
NODE_ENV=development
# Puerto donde escucha la API (queda en http://localhost:3000/api/v1)
PORT=3000
# true solo si hay un Nginx/balanceador delante (para leer la IP real)
TRUST_PROXY=false

# Usuario con el que Nest se conecta a Oracle (MAP_APP, permisos mínimos)
DB_USER=MAP_APP
# Contraseña de ese usuario. Te la da el DBA.
DB_PASSWORD=
# servidor:puerto/nombre_servicio
DB_CONNECT_STRING=localhost:1521/ORCLPDB1
# Dueño de las tablas si no es DB_USER (ej. MAP_OWNER). Vacío si usas sinónimos.
DB_SCHEMA=

# Firma de los tokens del iframe. Genera con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
EMBED_JWT_SECRET=
# Duración de cada token en segundos (60 a 600)
EMBED_TOKEN_TTL_SECONDS=600

# Origen del iframe (map-embed-web) y del panel (map-admin-web)
EMBED_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# Login del panel admin: oidc (SSO corporativo) o dev (token fijo; prohibido en producción)
ADMIN_AUTH_MODE=oidc
# Solo con ADMIN_AUTH_MODE=dev: mínimo 32 caracteres aleatorios
ADMIN_DEV_TOKEN=
# Proveedor OIDC. Entra ID: https://login.microsoftonline.com/<tenant>/v2.0  Keycloak: https://sso.tuorg.com/realms/<realm>
OIDC_ISSUER=
# Para quién fue emitido el token (lo da el equipo del SSO)
OIDC_AUDIENCE=
# Opcional: URL del JWKS si no se puede descubrir en /.well-known/openid-configuration
OIDC_JWKS_URI=
# Rol que deben tener los administradores
OIDC_ADMIN_ROLE=MAP_ADMIN

# Llave de ArcGIS de servidor (rutas y geocodificación). Nunca llega al navegador.
ARCGIS_SERVER_API_KEY=
# País para la geocodificación (ISO 3166 alfa-3)
ARCGIS_COUNTRY_CODE=COL
# true si guardarás en BD resultados del geocodificador (lo exigen los términos de ArcGIS; tiene otro costo)
ARCGIS_GEOCODE_FOR_STORAGE=false
